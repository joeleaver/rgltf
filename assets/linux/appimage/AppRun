#!/bin/sh
# AppImage entry point: launch the bundled rgltf, forwarding a file argument
# (the .desktop uses `Exec=rgltf %f`) so file-manager "Open with" and
# dragging a model onto the AppImage both open it.
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec "$HERE/usr/bin/rgltf" "$@"
